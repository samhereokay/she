# Anti-Theft & Recovery System Environment Template (Phase 2 MVP)

# Database Configuration
POSTGRES_USER=antitheft_user
POSTGRES_PASSWORD=antitheft_secure_password_dev
POSTGRES_DB=antitheft_db
DATABASE_URL=postgresql://antitheft_user:antitheft_secure_password_dev@localhost:5432/antitheft_db

# Security & Temporary Phase 2 Session Key
# Generate in production using: openssl rand -hex 32
SECRET_KEY=temporary-phase2-dev-secret-key-replace-in-production-64char-minimum-length-hash
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Location Data Retention (Days)
LOCATION_RETENTION_DAYS=30
