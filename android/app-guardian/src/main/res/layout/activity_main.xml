<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B1120">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Emergency Recovery Card (Shown during Stolen Kiosk Mode) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEmergencyContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            app:strokeWidth="2dp"
            app:strokeColor="#DC2626"
            app:cardBackgroundColor="#450A0A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvEmergencyHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 STOLEN DEVICE: RECOVERY ACTIVE"
                    android:textColor="#FCA5A5"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmergencyContactMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="This device is protected by SHE (Sentinel for Handheld Equipment). If found, please return to owner immediately:"
                    android:textColor="#FECACA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEmergencyPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Owner Emergency Contact: +1-555-0199"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCallEmergencyContact"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#DC2626"
                    android:text="CALL OWNER EMERGENCY CONTACT"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <Button
                    android:id="@+id/btnCallPolice112"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1E3A8A"
                    android:text="CALL EMERGENCY SERVICES (112)"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="10dp" />

                <TextView
                    android:id="@+id/tvKioskExitNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Kiosk lockdown can only be lifted by an owner-signed EXIT_KIOSK command from the registered Admin phone or via offline recovery key."
                    android:textColor="#FCA5A5"
                    android:textSize="11sp"
                    android:textStyle="italic" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Status Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            app:cardBackgroundColor="#0F172A">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_she_logo"
                        android:contentDescription="SHE Logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SHE GUARDIAN"
                            android:textColor="#F8FAFC"
                            android:textSize="20sp"
                            android:letterSpacing="0.05"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anti-Theft Sentinel Handset Service"
                            android:textColor="#10B981"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#064E3B"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="PROTECTED (ACTIVE)"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#1E293B" />

                <TextView
                    android:id="@+id/tvDeviceId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Device ID: loading..."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvLastLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Last Fix: None"
                    android:textColor="#38BDF8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvQueueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Offline Queue: 0 pending"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <!-- Map & Info Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnViewLocationMap"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="🗺️ View on Map"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnLocationInfo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="ℹ️ Info"
                        android:textSize="12sp"
                        android:textColor="#94A3B8"
                        app:strokeColor="#334155"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Capture & Sync Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCaptureNow"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#10B981"
                        android:textColor="#022C22"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="⚡ Capture Fix Now"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnSyncNow"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:textSize="12sp"
                        android:text="☁️ Sync to Server"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Pair with Admin Button -->
                <Button
                    android:id="@+id/btnPairWithAdmin"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="📷 Pair with Admin Phone (QR / Code)"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    app:strokeColor="#0284C7"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tier 1 Checklist Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            app:cardBackgroundColor="#1E293B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIER 1: OS SECURITY CHECKLIST"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Android system settings recommended for anti-theft defense"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbFindHub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#F8FAFC"
                    android:text="@string/tier1_find_hub" />

                <CheckBox
                    android:id="@+id/cbTheftDetection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F8FAFC"
                    android:text="@string/tier1_theft_detection" />

                <CheckBox
                    android:id="@+id/cbSimLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F8FAFC"
                    android:text="@string/tier1_sim_lock" />

                <CheckBox
                    android:id="@+id/cbPowerMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F8FAFC"
                    android:text="@string/tier1_power_menu" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tier 3 Device Owner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            app:cardBackgroundColor="#1E293B">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TIER 3: DEVICE OWNER"
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceOwnerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#78350F"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="CHECKING..."
                        android:textColor="#FDE68A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeviceOwnerDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Prevents factory reset, safe boot, and unauthorized uninstallation. Engages tamper-proof kiosk mode on theft."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRestrictionsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#0F172A"
                    android:padding="10dp"
                    android:textColor="#38BDF8"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:text="Loading restrictions status..." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEnforceRestrictions"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#065F46"
                        android:textColor="#D1FAE5"
                        android:textStyle="bold"
                        android:text="Lockdown (Enforce)"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnClearRestrictions"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="Clear Lockdown"
                        android:textColor="#94A3B8"
                        app:strokeColor="#334155"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleLockTaskKiosk"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="Enter Stolen Kiosk Mode"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnShowAdbCommand"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Show Provisioning ADB Command"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
