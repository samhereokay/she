<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Emergency Recovery Card (Shown during Stolen Kiosk Mode) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEmergencyContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EF4444"
            app:cardBackgroundColor="#351010">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvEmergencyHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STOLEN DEVICE: RECOVERY ACTIVE"
                    android:textColor="#EF4444"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmergencyContactMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="This device is protected by SHE (Sentinel for Handheld Equipment). If found, please return to owner immediately:"
                    android:textColor="#F5F5F7"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEmergencyPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Owner Emergency Contact: +1-555-0199"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCallEmergencyContact"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#EF4444"
                    android:text="CALL OWNER EMERGENCY CONTACT"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <Button
                    android:id="@+id/btnCallPolice112"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1C1C1E"
                    app:strokeColor="#2C2C2E"
                    app:strokeWidth="1dp"
                    android:text="CALL EMERGENCY SERVICES (112)"
                    android:textColor="#F5F5F7"
                    app:cornerRadius="10dp" />

                <TextView
                    android:id="@+id/tvKioskExitNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Kiosk lockdown can only be lifted by an owner-signed EXIT_KIOSK command from the registered Admin phone or via offline recovery key."
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Status Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2C2C2E"
            app:cardBackgroundColor="#121212">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_she_logo"
                        android:contentDescription="SHE Logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SHE GUARDIAN"
                            android:textColor="#F5F5F7"
                            android:textSize="20sp"
                            android:letterSpacing="0.05"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anti-Theft Sentinel Handset Service"
                            android:textColor="#A1A1AA"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_success"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="PROTECTED (ACTIVE)"
                        android:textColor="#22C55E"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#2C2C2E" />

                <TextView
                    android:id="@+id/tvDeviceId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Device ID: loading..."
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvLastLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Last Fix: None"
                    android:textColor="#F5F5F7"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvQueueCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Offline Queue: 0 pending"
                    android:textColor="#71717A"
                    android:textSize="12sp" />

                <!-- Map & Info Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnViewLocationMap"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#1C1C1E"
                        app:strokeColor="#2C2C2E"
                        app:strokeWidth="1dp"
                        android:text="View on Map"
                        android:textColor="#F5F5F7"
                        android:textSize="12sp"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnLocationInfo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="#1C1C1E"
                        app:strokeColor="#2C2C2E"
                        app:strokeWidth="1dp"
                        android:text="Info"
                        android:textSize="12sp"
                        android:textColor="#A1A1AA"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Capture & Sync Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCaptureNow"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:text="Capture Fix Now"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btnSyncNow"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1C1C1E"
                        app:strokeColor="#2C2C2E"
                        app:strokeWidth="1dp"
                        android:textColor="#F5F5F7"
                        android:textSize="12sp"
                        android:text="Sync to Server"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Pair with Admin Button -->
                <Button
                    android:id="@+id/btnPairWithAdmin"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#1C1C1E"
                    app:strokeColor="#2C2C2E"
                    app:strokeWidth="1dp"
                    android:text="Pair with Admin Phone (QR / Code)"
                    android:textColor="#F5F5F7"
                    android:textSize="13sp"
                    app:cornerRadius="10dp" />

                <!-- Share Guardian APK Button -->
                <Button
                    android:id="@+id/btnShareGuardianApk"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1C1C1E"
                    app:strokeColor="#2C2C2E"
                    app:strokeWidth="1dp"
                    android:text="Share Guardian APK / Link (Bluetooth / Web)"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- OEM Background & Battery Guidance Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOemGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2C2C2E"
            app:cardBackgroundColor="#121212">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TIER 2: OEM BACKGROUND &amp; BATTERY"
                        android:textColor="#F5F5F7"
                        android:textSize="13sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiteBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_success"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="LITE ACTIVE"
                        android:textColor="#22C55E"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Guardian Lite operates without Device Admin permissions, utilizing foreground location services and SMS beacons. Review OEM battery settings to ensure continuous protection."
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAdminGuide"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:backgroundTint="#1C1C1E"
                        app:strokeColor="#2C2C2E"
                        app:strokeWidth="1dp"
                        android:text="OEM &amp; Brand Setup Guide"
                        android:textColor="#F5F5F7"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tier 1 Checklist Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2C2C2E"
            app:cardBackgroundColor="#121212">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIER 1: OS SECURITY CHECKLIST"
                    android:textColor="#F5F5F7"
                    android:textSize="13sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Android system settings recommended for anti-theft defense"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/cbFindHub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#F5F5F7"
                    android:text="@string/tier1_find_hub" />

                <CheckBox
                    android:id="@+id/cbTheftDetection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F5F5F7"
                    android:text="@string/tier1_theft_detection" />

                <CheckBox
                    android:id="@+id/cbSimLock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F5F5F7"
                    android:text="@string/tier1_sim_lock" />

                <CheckBox
                    android:id="@+id/cbPowerMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F5F5F7"
                    android:text="@string/tier1_power_menu" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tier 3 Device Owner Card (Part 2: Hardened Flavor) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2C2C2E"
            app:cardBackgroundColor="#121212">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TIER 3: DEVICE OWNER"
                        android:textColor="#F5F5F7"
                        android:textSize="13sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceOwnerBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_warning"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="CHECKING..."
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeviceOwnerDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Prevents factory reset, safe boot, and unauthorized uninstallation. Engages tamper-proof kiosk mode on theft."
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvRestrictionsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#1C1C1E"
                    android:padding="10dp"
                    android:textColor="#F5F5F7"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:text="Loading restrictions status..." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnEnforceRestrictions"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#351010"
                        app:strokeColor="#EF4444"
                        app:strokeWidth="1dp"
                        android:textColor="#EF4444"
                        android:textStyle="bold"
                        android:text="Lockdown (Enforce)"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnClearRestrictions"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1C1C1E"
                        app:strokeColor="#2C2C2E"
                        app:strokeWidth="1dp"
                        android:text="Clear Lockdown"
                        android:textColor="#F5F5F7"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleLockTaskKiosk"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#1C1C1E"
                    app:strokeColor="#2C2C2E"
                    app:strokeWidth="1dp"
                    android:text="Enter Stolen Kiosk Mode"
                    android:textColor="#F5F5F7"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />

                <Button
                    android:id="@+id/btnShowAdbCommand"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Show Provisioning ADB Command"
                    android:textColor="#A1A1AA"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
