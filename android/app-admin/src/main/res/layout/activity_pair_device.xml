<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Point the Guardian phone camera at this QR code to establish cryptographic pairing and 48-bit SMS secret."
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Pairing QR Code" />

        <TextView
            android:id="@+id/tvPairingSecret"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Pairing Secret: generating..."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etAdminPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Admin Phone Number (for SMS replies)"
            android:inputType="phone"
            android:textAlignment="center" />

        <EditText
            android:id="@+id/etConfirmCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Enter confirmation code from Guardian"
            android:inputType="text"
            android:textAlignment="center" />

        <Button
            android:id="@+id/btnApprovePairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Confirm &amp; Activate Guardian" />

        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Done / Back to Devices" />

    </LinearLayout>
</ScrollView>
